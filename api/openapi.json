  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "KampListItemDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unieke ID van het kamp"
          },
          "naam": {
            "type": "string",
            "example": "Zomerkamp 2025",
            "description": "Naam van het kamp"
          },
          "stad": {
            "type": "string",
            "example": "Gent",
            "description": "Stad waar het kamp doorgaat"
          },
          "startDatum": {
            "type": "string",
            "example": "2025-07-15",
            "description": "Startdatum van het kamp",
            "format": "date"
          },
          "eindDatum": {
            "type": "string",
            "example": "2025-07-22",
            "description": "Einddatum van het kamp",
            "format": "date"
          }
        },
        "required": [
          "id",
          "naam",
          "stad",
          "startDatum",
          "eindDatum"
        ]
      },
      "KampenListResponseDto": {
        "type": "object",
        "properties": {
          "items": {
            "description": "Lijst van kampen",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KampListItemDto"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "KampLidResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unieke ID van het kamp-lid"
          },
          "voornaam": {
            "type": "string",
            "example": "Lars",
            "description": "Voornaam van het kamp-lid"
          },
          "achternaam": {
            "type": "string",
            "example": "Janssens",
            "description": "Achternaam van het kamp-lid"
          }
        },
        "required": [
          "id",
          "voornaam",
          "achternaam"
        ]
      },
      "KampLeidingResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unieke ID van de leiding"
          },
          "voornaam": {
            "type": "string",
            "example": "Emma",
            "description": "Voornaam van de leiding"
          },
          "achternaam": {
            "type": "string",
            "example": "Vermeulen",
            "description": "Achternaam van de leiding"
          }
        },
        "required": [
          "id",
          "voornaam",
          "achternaam"
        ]
      },
      "KampResponseDto": {
        "type": "object",
        "properties": {
          "naam": {
            "type": "string",
            "example": "Zomerkamp 2025",
            "description": "Naam van het kamp"
          },
          "stad": {
            "type": "string",
            "example": "Gent",
            "description": "Stad waar het kamp doorgaat"
          },
          "beschrijving": {
            "type": "string",
            "example": "Een week vol activiteiten voor jongeren.",
            "description": "Korte beschrijving van het kamp"
          },
          "startDatum": {
            "type": "string",
            "example": "2025-07-15",
            "description": "Startdatum van het kamp",
            "format": "date"
          },
          "eindDatum": {
            "type": "string",
            "example": "2025-07-22",
            "description": "Einddatum van het kamp",
            "format": "date"
          },
          "id": {
            "type": "number",
            "example": 1,
            "description": "Unieke ID van het kamp"
          },
          "leden": {
            "description": "Lijst van leden in dit kamp",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KampLidResponseDto"
            }
          },
          "leiding": {
            "description": "Lijst van leiding in dit kamp",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/KampLeidingResponseDto"
            }
          }
        },
        "required": [
          "naam",
          "stad",
          "beschrijving",
